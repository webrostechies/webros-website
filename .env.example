# ─────────────────────────────────────────────────────────────
# WEBros Techies — form delivery configuration
# Copy this file to `.env.local` and fill in ONE provider.
# All values are public (bundled into the client) — only use
# provider keys that are designed to be exposed in the browser.
# ─────────────────────────────────────────────────────────────

# formspree | web3forms | emailjs | webhook
VITE_FORM_PROVIDER=

# Formspree — https://formspree.io  (form IDs, e.g. "xyzabcd")
VITE_FORMSPREE_CONTACT_ID=
VITE_FORMSPREE_NEWSLETTER_ID=

# Web3Forms — https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# EmailJS — https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Generic webhook (e.g. a Google Apps Script web app that appends to a Sheet / sends mail)
VITE_WEBHOOK_URL=

# Public site URL, used for canonical + Open Graph URLs
VITE_SITE_URL=
